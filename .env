# =========================================================
# DIVYADHARA - APPLICATION
# =========================================================

NODE_ENV=development

PORT=3001
HOST=0.0.0.0


# =========================================================
# FRONTEND -> BACKEND API
# =========================================================

VITE_API_URL=http://localhost:3001


# =========================================================
# APPLICATION URLS
# =========================================================

APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001


# =========================================================
# AUTHENTICATION
# =========================================================

AUTH_COOKIE_NAME=divyadhara_session

# Session lifetime in days
SESSION_DAYS=7

# Password reset token lifetime in minutes
PASSWORD_RESET_MINUTES=30

# Email verification token lifetime in minutes
VERIFICATION_TOKEN_MINUTES=30


# =========================================================
# SQLITE DATABASE
# =========================================================

# Relative path is resolved from project working directory.
DIVYADHARA_DB_PATH=./data/divyadhara.sqlite

# Optional absolute path:
# DIVYADHARA_DB_PATH=/var/lib/divyadhara/divyadhara.sqlite


# =========================================================
# SUPER ADMIN BOOTSTRAP
# =========================================================
#
# Used by:
#
# npx tsx server/scripts/create-super-admin.ts
#
# Existing Super Admin accounts are synchronized by the
# updated bootstrap script.
#

SUPER_ADMIN_NAME="DivyaDhara Admin"
SUPER_ADMIN_EMAIL="dharadivya59@gmail.com"
SUPER_ADMIN_PASSWORD="Divya-Dhara@123"


# =========================================================
# LEAD / CRAWLER SETTINGS
# =========================================================

JOB_LIMIT=999999
MIN_FILE_BYTES=20000

REQUEST_DELAY_MS=2500
DOWNLOAD_DELAY_MS=1500

MAX_RETRIES=2

INITIAL_BACKOFF_MS=4000
MAX_BACKOFF_MS=90000

PROVIDER_COOLDOWN_MS=900000

REQUEST_TIMEOUT_MS=20000
PAGE_TIMEOUT_MS=15000


# =========================================================
# SEARCH APIs
# =========================================================

# Google Custom Search API
GOOGLE_API_KEY=

# Google Programmable Search Engine ID
GOOGLE_CX=b7dc9303538e845d1

# Bing Image Search
BING_IMAGE_SEARCH_KEY=


# =========================================================
# AI / COMFYUI
# =========================================================

AI_FALLBACK=true

COMFYUI_URL=http://127.0.0.1:8188

COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

COMFYUI_WIDTH=1024
COMFYUI_HEIGHT=1024

COMFYUI_STEPS=28
COMFYUI_CFG=7

COMFYUI_SAMPLER=euler
COMFYUI_SCHEDULER=normal

COMFYUI_POLL_MS=2500
COMFYUI_MAX_WAIT_MS=600000


# =========================================================
# YOUTUBE DATA API
# =========================================================
#
# IMPORTANT:
# Keep this key server-side only.
# Never create VITE_YOUTUBE_API_KEY.
#
YOUTUBE_API_KEY=AIzaSyCqt-f99mTPCj9YmWLrvmYgEX--er__p0Y


# =========================================================
# CORS
# =========================================================
#
# Include the Vite development ports commonly used by the
# frontend. The backend should allow only known origins.
#

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174


# =========================================================
# PRODUCTION CORS EXAMPLE
# =========================================================
#
# When deployed:
#
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
#
# And:
#
# VITE_API_URL=https://api.your-domain.com
# APP_URL=https://your-domain.com
# FRONTEND_URL=https://your-domain.com
# BACKEND_URL=https://api.your-domain.com
#
# =========================================================


# =========================================================
# OPTIONAL FEATURE FLAGS
# =========================================================

AI_FALLBACK=true